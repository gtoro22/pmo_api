# =============================================================================
# Configuracion del invocador de Tracking Goals (Amagi)
# Copiar este archivo como `.env` y completar los valores reales.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# API (endpoint base + secretos)
# IMPORTANTE: aqui solo va el ENDPOINT BASE. Las rutas concretas de la API
# (ej. /api/v1/tracking_goals) viven en la capa de infraestructura del DDD:
#   src/tracking_goals/infrastructure/http/endpoints.py
# -----------------------------------------------------------------------------
AMAGI_API_BASE_URL=https://amagi.elearning.co
AMAGI_API_TOKEN=coloque-aqui-su-bearer-token

# Segundos de espera maxima por peticion HTTP
AMAGI_API_TIMEOUT=30

# Reintentos ante errores de red / 5xx
AMAGI_API_MAX_REINTENTOS=3
AMAGI_API_BACKOFF=2

# Verificacion de certificados TLS (dejar en true en produccion)
AMAGI_API_VERIFICAR_SSL=true

# -----------------------------------------------------------------------------
# Valores por defecto de consulta
# -----------------------------------------------------------------------------
AMAGI_PROYECTO_DEFECTO=
AMAGI_PER_PAGE_DEFECTO=50

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# -----------------------------------------------------------------------------
# Salida (Excel)
# -----------------------------------------------------------------------------
OUTPUT_DIR=output
