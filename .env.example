# =============================================================================
# Configuracion del invocador de Tracking Goals (Amagi)
# Copiar este archivo como `.env` y completar los valores reales.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# API (endpoint base + secretos)
# IMPORTANTE: aqui solo va el ENDPOINT BASE. Las rutas concretas de la API
# (ej. /api/v1/tracking_goals) viven en la capa de infraestructura del DDD:
#   src/tracking_goals/infrastructure/http/endpoints.py
# -----------------------------------------------------------------------------
AMAGI_API_BASE_URL=https://amagi.elearning.co
AMAGI_API_TOKEN=coloque-aqui-su-bearer-token

# Segundos de espera maxima por peticion HTTP
AMAGI_API_TIMEOUT=30

# Reintentos ante errores de red / 5xx
AMAGI_API_MAX_REINTENTOS=3
AMAGI_API_BACKOFF=2

# Verificacion de certificados TLS (dejar en true en produccion)
AMAGI_API_VERIFICAR_SSL=true

# -----------------------------------------------------------------------------
# Valores por defecto de consulta
# -----------------------------------------------------------------------------
AMAGI_PROYECTO_DEFECTO=
AMAGI_PER_PAGE_DEFECTO=50

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# -----------------------------------------------------------------------------
# Salida (Excel)
# -----------------------------------------------------------------------------
OUTPUT_DIR=output

# =============================================================================
# Entrega remota del Excel (SFTP / FTP / FTPS)
# =============================================================================
# Interruptor principal. En false el invocador solo deja el Excel en disco y
# ninguna otra variable de esta seccion se usa.
ENVIO_HABILITADO=false

# Protocolo: sftp | ftp | ftps
#   sftp  transferencia sobre SSH (recomendado)
#   ftps  FTP sobre TLS
#   ftp   sin cifrado: credenciales y archivo viajan en claro
ENVIO_PROTOCOLO=sftp

# --- Conexion ---
ENVIO_HOST=
# Si se deja vacio: 22 para sftp, 21 para ftp/ftps
ENVIO_PUERTO=
ENVIO_USUARIO=
ENVIO_PASSWORD=

# --- Autenticacion por llave (solo sftp; alternativa a ENVIO_PASSWORD) ---
ENVIO_LLAVE_PRIVADA=
ENVIO_LLAVE_PASSPHRASE=

# --- Destino ---
# Directorio remoto donde se deja el archivo
ENVIO_DIRECTORIO_REMOTO=/reportes/objetivos
# Nombre fijo en el servidor. Vacio = conserva el nombre local con su fecha
ENVIO_NOMBRE_REMOTO=
# Crea el directorio remoto (y sus padres) si no existe
ENVIO_CREAR_DIRECTORIO=true

# --- Seguridad y tiempos ---
ENVIO_TIMEOUT=30
# true  = solo conecta si la llave del servidor esta en known_hosts (recomendado)
# false = acepta cualquier llave; expone la conexion a suplantacion
ENVIO_VERIFICAR_HOST_KEY=true
# Ruta a un known_hosts propio. Vacio = usa el del sistema (~/.ssh/known_hosts)
ENVIO_KNOWN_HOSTS=

# --- Solo FTP/FTPS ---
ENVIO_FTP_PASIVO=true
